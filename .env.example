# 使用 `python -c "import secrets; print(secrets.token_urlsafe(50))"` 生成。
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
COOKIE_SECURE=false
TZ=Asia/Shanghai
# Access Token 只保存在浏览器内存；Refresh Token 保存在 HttpOnly Cookie。
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_EMAIL=
WEB_PORT=8088

# 直接暴露端口时保持 0；仅在可信反向代理后按实际代理层数设置。
TRUSTED_PROXY_COUNT=0
# WebRTC 地址是浏览器自报的辅助线索；服务端观测地址仍是审计主依据。
WEBRTC_IP_COLLECTION_ENABLED=true
WEBRTC_STUN_URL=stun:stun.l.google.com:19302
